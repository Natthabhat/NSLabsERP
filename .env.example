# Register a Google OAuth Web application and enable Google Sheets API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional comma-separated Google emails allowed into this app.
ALLOWED_EMAILS=

# PostgreSQL backend (server-side only). Keep credentials out of Git.
DATA_BACKEND=postgres
DATABASE_URL=
POSTGRES_LOGIN_USER=natthabhat
